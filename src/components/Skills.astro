---
import { translations } from '../i18n/translations';

const esSkills = translations.es.skills;
const enSkills = translations.en.skills;
---

<section class="mb-5">
  <h2 class="flex items-center gap-[0.6rem] text-[1.1rem] font-bold text-gray-900 mb-4 pb-2 border-b-2 border-[var(--color-primary-border)]">
    <span class="section-icon flex items-center justify-center w-[30px] h-[30px] bg-[var(--color-primary-light)] rounded-lg shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[var(--color-primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="16 18 22 12 16 6"/>
        <polyline points="8 6 2 12 8 18"/>
      </svg>
    </span>
    <span lang="es">{esSkills.title}</span>
    <span lang="en">{enSkills.title}</span>
  </h2>
  <div class="grid grid-cols-2 gap-3 max-sm:grid-cols-1">
    {esSkills.groups.map((group, i) => {
      const enGroup = enSkills.groups[i];
      return (
        <div class="skills-group bg-white border border-gray-200 rounded-lg p-4 shadow-sm print:shadow-none">
          <p class="text-[0.7rem] font-bold tracking-[0.08em] text-gray-400 mb-[0.6rem] uppercase">
            <span lang="es">{group.label}</span>
            <span lang="en">{enGroup.label}</span>
          </p>
          <div class="flex flex-wrap gap-[0.4rem]">
            {group.tags.map((tag) => (
              <span class="tag bg-[var(--color-primary-light)] text-[var(--color-primary)] text-[0.78rem] font-medium px-[0.6rem] py-[0.2rem] rounded-full border border-[var(--color-primary-border)]">{tag}</span>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</section>
