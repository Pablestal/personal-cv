---
import { translations } from '../i18n/translations';

const esSkills = translations.es.skills;
const enSkills = translations.en.skills;
---

<section class="section">
  <h2 class="section-title">
    <span class="section-icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="16 18 22 12 16 6"/>
        <polyline points="8 6 2 12 8 18"/>
      </svg>
    </span>
    <span lang="es">{esSkills.title}</span>
    <span lang="en">{enSkills.title}</span>
  </h2>
  <div class="skills-grid">
    {esSkills.groups.map((group, i) => {
      const enGroup = enSkills.groups[i];
      return (
        <div class="skills-group">
          <p class="skills-label">
            <span lang="es">{group.label}</span>
            <span lang="en">{enGroup.label}</span>
          </p>
          <div class="skills-tags">
            {group.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</section>
