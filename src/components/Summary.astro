---
import { translations } from '../i18n/translations';

const es = translations.es.summary;
const en = translations.en.summary;
---

<section class="mb-5">
  <h2 class="flex items-center gap-[0.6rem] text-[1.1rem] font-bold text-gray-900 mb-4 pb-2 border-b-2 border-[var(--color-primary-border)]">
    <span class="section-icon flex items-center justify-center w-[30px] h-[30px] bg-[var(--color-primary-light)] rounded-lg shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[var(--color-primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
    </span>
    <span lang="es">{es.title}</span>
    <span lang="en">{en.title}</span>
  </h2>
  <div class="bg-white border border-gray-200 rounded-xl px-6 py-5 shadow-sm text-[0.9rem] text-gray-700 leading-[1.7] print:shadow-none">
    <p lang="es">{es.text}</p>
    <p lang="en">{en.text}</p>
  </div>
</section>
