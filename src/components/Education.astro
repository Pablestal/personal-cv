---
import { translations } from '../i18n/translations';

const esEdu = translations.es.education;
const enEdu = translations.en.education;
const esCert = translations.es.certifications;
const enCert = translations.en.certifications;
---

<section class="mb-5">
  <h2 class="flex items-center gap-[0.6rem] text-[1.1rem] font-bold text-gray-900 mb-4 pb-2 border-b-2 border-blue-100">
    <span class="section-icon flex items-center justify-center w-[30px] h-[30px] bg-blue-50 rounded-lg shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
        <path d="M6 12v5c3 3 9 3 12 0v-5"/>
      </svg>
    </span>
    <span lang="es">{esEdu.title}</span>
    <span lang="en">{enEdu.title}</span>
  </h2>
  <div class="bg-white border border-gray-200 rounded-xl p-4 px-5 shadow-sm print:shadow-none">
    <p class="text-[0.75rem] font-bold text-blue-600 mb-[0.35rem]">2020</p>
    <div class="flex items-baseline gap-2 flex-wrap">
      <h3 class="text-[0.9rem] font-semibold text-gray-900">
        <span lang="es">{esEdu.degree}</span>
        <span lang="en">{enEdu.degree}</span>
      </h3>
      <p class="text-[0.83rem] text-gray-500">{esEdu.school}</p>
    </div>
    <p class="text-[0.78rem] text-gray-400 mt-[0.2rem]">
      <span lang="es">{esEdu.mention}</span>
      <span lang="en">{enEdu.mention}</span>
    </p>
  </div>
</section>

<section class="mb-5">
  <h2 class="flex items-center gap-[0.6rem] text-[1.1rem] font-bold text-gray-900 mb-4 pb-2 border-b-2 border-blue-100">
    <span class="section-icon flex items-center justify-center w-[30px] h-[30px] bg-blue-50 rounded-lg shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 11 12 14 22 4"/>
        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
      </svg>
    </span>
    <span lang="es">{esCert.title}</span>
    <span lang="en">{enCert.title}</span>
  </h2>
  {esCert.items.map((item) => (
    <div class="bg-white border border-gray-200 rounded-xl p-4 px-5 shadow-sm mb-2 flex items-center justify-between print:shadow-none">
      <div class="flex-1">
        <p class="text-[0.75rem] font-bold text-blue-600 mb-[0.35rem]">{item.year}</p>
        <div class="flex items-baseline gap-2 flex-wrap">
          <h3 class="text-[0.9rem] font-semibold text-gray-900">{item.name}</h3>
          <p class="text-[0.83rem] text-gray-500">{item.issuer}</p>
        </div>
      </div>
      {item.logo && (
        <img src={item.logo} alt={item.name} class="w-[52px] h-[52px] object-contain shrink-0 ml-4" loading="lazy" decoding="async" width="52" height="52" />
      )}
    </div>
  ))}
</section>
