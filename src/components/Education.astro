---
import { translations } from '../i18n/translations';

const esEdu = translations.es.education;
const enEdu = translations.en.education;
const esCert = translations.es.certifications;
const enCert = translations.en.certifications;
---

<section class="section">
  <h2 class="section-title">
    <span class="section-icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
        <path d="M6 12v5c3 3 9 3 12 0v-5"/>
      </svg>
    </span>
    <span lang="es">{esEdu.title}</span>
    <span lang="en">{enEdu.title}</span>
  </h2>
  <div class="card">
    <p class="card-year">2020</p>
    <div class="card-row">
      <h3 class="card-title">
        <span lang="es">{esEdu.degree}</span>
        <span lang="en">{enEdu.degree}</span>
      </h3>
      <p class="card-subtitle">{esEdu.school}</p>
    </div>
    <p class="card-note">
      <span lang="es">{esEdu.mention}</span>
      <span lang="en">{enEdu.mention}</span>
    </p>
  </div>
</section>

<section class="section">
  <h2 class="section-title">
    <span class="section-icon section-icon--green">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 11 12 14 22 4"/>
        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
      </svg>
    </span>
    <span lang="es">{esCert.title}</span>
    <span lang="en">{enCert.title}</span>
  </h2>
  {esCert.items.map((item) => {
    return (
      <div class="card cert-card" style="margin-bottom: 0.5rem;">
        <div class="cert-card-content">
          <p class="card-year">{item.year}</p>
          <div class="card-row">
            <h3 class="card-title">{item.name}</h3>
            <p class="card-subtitle">{item.issuer}</p>
          </div>
        </div>
        {item.logo && (
          <img src={item.logo} alt={item.name} class="cert-logo" />
        )}
      </div>
    );
  })}
</section>
