---
import { translations } from '../i18n/translations';
---

<nav class="sticky top-0 z-[100] bg-white border-b border-gray-200 px-6 py-[0.65rem] flex items-center justify-between shadow-[0_1px_4px_rgba(0,0,0,0.05)] print:hidden">
  <span class="text-[0.9rem] font-semibold text-gray-900 max-sm:hidden">Pablo Estévez Álvarez</span>
  <div class="flex items-center gap-3">
    <div class="flex border border-gray-200 rounded-full overflow-hidden">
      <button class="lang-btn px-3 py-[0.28rem] text-[0.78rem] font-semibold bg-transparent border-none cursor-pointer text-gray-500 transition-[background,color] duration-150" data-lang-btn="es">ES</button>
      <button class="lang-btn px-3 py-[0.28rem] text-[0.78rem] font-semibold bg-transparent border-none cursor-pointer text-gray-500 transition-[background,color] duration-150" data-lang-btn="en">EN</button>
    </div>
    <button class="flex items-center gap-[0.35rem] px-[0.85rem] py-[0.35rem] bg-blue-600 text-white border-none rounded-full text-[0.78rem] font-semibold cursor-pointer transition-opacity duration-150 hover:opacity-85" id="pdf-btn">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-[13px] h-[13px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="7 10 12 15 17 10"/>
        <line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      <span lang="es">{translations.es.nav.downloadPdf}</span>
      <span lang="en">{translations.en.nav.downloadPdf}</span>
    </button>
  </div>
</nav>

<script>
  function setLang(lang: string) {
    document.documentElement.lang = lang;
    localStorage.setItem('cv_lang', lang);
    document.querySelectorAll('[data-lang-btn]').forEach((btn) => {
      const el = btn as HTMLElement;
      if (el.dataset.langBtn === lang) {
        el.classList.add('active');
      } else {
        el.classList.remove('active');
      }
    });
  }

  const savedLang = localStorage.getItem('cv_lang') || 'es';
  setLang(savedLang);

  document.querySelectorAll('[data-lang-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      const lang = el.dataset.langBtn;
      if (lang) setLang(lang);
    });
  });

  const pdfBtn = document.getElementById('pdf-btn');
  if (pdfBtn) {
    pdfBtn.addEventListener('click', () => {
      window.print();
    });
  }
</script>
