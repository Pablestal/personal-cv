---
import { translations } from '../i18n/translations';

const esExp = translations.es.experience;
const enExp = translations.en.experience;
const jobs = esExp.jobs;
---

<section class="section">
  <h2 class="section-title">
    <span class="section-icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
      </svg>
    </span>
    <span lang="es">{esExp.title}</span>
    <span lang="en">{enExp.title}</span>
  </h2>
  <div class="timeline">
    {jobs.map((job, i) => {
      const enJob = enExp.jobs[i];
      const isActive = job.dates === null;
      return (
        <div class="job">
          <div class={`job-dot${isActive ? ' job-dot--active' : ''}`}></div>
          <div class="job-content">
            <div class="job-header">
              <div>
                <h3 class="job-title">
                  <span lang="es">{job.title}</span>
                  <span lang="en">{enJob.title}</span>
                </h3>
                <p class="job-company">
                  <span lang="es">{job.company}</span>
                  <span lang="en">{enJob.company}</span>
                </p>
              </div>
              {isActive ? (
                <span class="badge-current">
                  <span lang="es">{esExp.current}</span>
                  <span lang="en">{enExp.current}</span>
                </span>
              ) : (
                <span class="job-dates">{job.dates}</span>
              )}
            </div>
            <ul class="job-bullets">
              {job.bullets.map((bullet, bi) => (
                <>
                  <li lang="es">{bullet}</li>
                  <li lang="en">{enJob.bullets[bi]}</li>
                </>
              ))}
            </ul>
          </div>
        </div>
      );
    })}
  </div>
</section>
