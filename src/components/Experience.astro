---
import { translations } from '../i18n/translations';

const esExp = translations.es.experience;
const enExp = translations.en.experience;
const jobs = esExp.jobs;
---

<section class="mb-5">
  <h2 class="flex items-center gap-[0.6rem] text-[1.1rem] font-bold text-gray-900 mb-4 pb-2 border-b-2 border-blue-100">
    <span class="section-icon flex items-center justify-center w-[30px] h-[30px] bg-blue-50 rounded-lg shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
      </svg>
    </span>
    <span lang="es">{esExp.title}</span>
    <span lang="en">{enExp.title}</span>
  </h2>
  <div class="timeline relative pl-7">
    {jobs.map((job, i) => {
      const enJob = enExp.jobs[i];
      const isActive = job.dates === null;
      return (
        <div class="job relative mb-3 last:mb-0">
          <div class={`job-dot absolute left-[-1.75rem] top-1.5 w-4 h-4 rounded-full border-2 ${isActive ? 'job-dot--active bg-blue-600 border-blue-600 shadow-[0_0_0_3px_#dbeafe]' : 'bg-white border-gray-200'}`}></div>
          <div class="bg-white border border-gray-200 rounded-xl p-4 px-5 shadow-sm print:shadow-none">
            <div class="job-header flex justify-between items-start gap-3 mb-3">
              <div>
                <h3 class="text-[0.95rem] font-semibold text-gray-900">
                  <span lang="es">{job.title}</span>
                  <span lang="en">{enJob.title}</span>
                </h3>
                <p class="text-[0.85rem] text-gray-500 mt-[0.15rem]">
                  <span lang="es">{job.company}</span>
                  <span lang="en">{enJob.company}</span>
                </p>
              </div>
              {isActive ? (
                <span class="badge-current inline-block bg-blue-600 text-white text-[0.7rem] font-semibold tracking-[0.05em] px-[0.55rem] py-[0.2rem] rounded-full whitespace-nowrap shrink-0">
                  <span lang="es">{esExp.current}</span>
                  <span lang="en">{enExp.current}</span>
                </span>
              ) : (
                <span class="text-[0.82rem] text-gray-500 whitespace-nowrap shrink-0 pt-[0.1rem]">{job.dates}</span>
              )}
            </div>
            <ul class="job-bullets flex flex-col gap-[0.4rem]">
              {job.bullets.map((bullet, bi) => (
                <>
                  <li lang="es" class="text-[0.85rem] text-gray-700 leading-[1.55]">{bullet}</li>
                  <li lang="en" class="text-[0.85rem] text-gray-700 leading-[1.55]">{enJob.bullets[bi]}</li>
                </>
              ))}
            </ul>
          </div>
        </div>
      );
    })}
  </div>
</section>
