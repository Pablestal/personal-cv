---
import '../styles/global.css';
import { themeStorageKey } from '../config/theme';
---
<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pablo Estévez Álvarez — Frontend Developer</title>
  <meta name="description" content="CV de Pablo Estévez Álvarez — Frontend Developer con experiencia en React, TypeScript y desarrollo web moderno." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline define:vars={{ themeStorageKey }}>
    (function() {
      var root = document.documentElement;

      var lang = localStorage.getItem('cv_lang') || 'es';
      root.lang = lang;

      // Applied before first paint so the accent never flashes blue first. The
      // stored value is already contrast-checked (see src/config/theme.ts), and
      // the tinted tones derive from it in CSS.
      var accent = localStorage.getItem(themeStorageKey);
      if (/^#[0-9a-f]{6}$/i.test(accent || '')) {
        root.style.setProperty('--color-primary', accent);
      }
    })();
  </script>
</head>
<body class="bg-gray-50 text-gray-700 leading-relaxed antialiased">
  <slot />
</body>
</html>
